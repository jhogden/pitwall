# Copy this file to `.env` and fill in real values.
# Docker Compose auto-loads `.env` from the repo root.

# --- Database ---
POSTGRES_DB=pitwall
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=pitwall_dev

# --- Backend (Spring) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pitwall
SPRING_DATASOURCE_USERNAME=pitwall
SPRING_DATASOURCE_PASSWORD=pitwall_dev
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
JWT_SECRET=change-me-in-production-min-256-bits
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Data Services ---
DATABASE_URL=postgresql://pitwall:pitwall_dev@postgres:5432/pitwall
REDIS_URL=redis://redis:6379
BACKEND_API_URL=http://backend:8080
YOUTUBE_API_KEY=
